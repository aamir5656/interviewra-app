ENV=development
DATABASE_URL=postgresql+asyncpg://interviewra:interviewra@localhost:5432/interviewra
SECRET_KEY=change-me-use-python-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=60
GUEST_TOKEN_EXPIRE_DAYS=7
REFRESH_GRACE_DAYS=7
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=gemini
LLM_MODEL=your-model-name
LLM_API_KEY=fake-api-key
LLM_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=6
HISTORY_WINDOW=12
ENABLE_PARALLEL_EVAL=false
MAX_UPLOAD_MB=5
CLEANUP_INTERVAL_HOURS=24
GUEST_RETENTION_DAYS=30
ABANDON_AFTER_DAYS=3
SESSION_RETENTION_DAYS=365
LIMIT_GUEST_INTERVIEWS_PER_DAY=3
LIMIT_GUEST_MESSAGES_PER_DAY=60
LIMIT_GUEST_RESUMES_PER_DAY=1
LIMIT_USER_INTERVIEWS_PER_DAY=10
LIMIT_USER_MESSAGES_PER_DAY=300
LIMIT_USER_RESUMES_PER_DAY=5
# One small extra model call per answer that spots wrong or unprofessional answers, so the interviewer asks a follow-up.
# Set to false to save free-tier quota (the interviewer then only follows up on vague or flagged answers).
ANSWER_JUDGE=true
# The interviewer wraps each main question in <q></q> so the code stores the exact question (used for repeats and the report).
STRICT_QUESTION_TAGS=true
